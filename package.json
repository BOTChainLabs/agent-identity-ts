{
  "name": "@botchain/agent-identity",
  "version": "0.1.0",
  "description": "BOT Chain ERC-8004 IdentityRegistry Direct SDK (TypeScript / Viem)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && mkdir -p dist/abi && cp src/abi/IdentityRegistry.json dist/abi/IdentityRegistry.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "botchain",
    "erc-8004",
    "identity",
    "viem"
  ],
  "license": "MIT",
  "dependencies": {
    "viem": "^2.37.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "dotenv": "^16.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  }
}
